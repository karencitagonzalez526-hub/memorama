    función calcularEstrellas(segundos, totalPairsCount) {
        const idealPerPair = 2.8;
        const twoStarLimit = 4.5;
        const expectedIdeal = totalPairsCount * idealPerPair;
        const expectedTwo = totalPairsCount * twoStarLimit;
        Si (segundos <= expectedIdeal) devuelve 3;
        Si (segundos <= expectedTwo) devuelve 2;
        devolver 1;
    }

