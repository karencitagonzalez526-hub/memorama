        } else if (secondCardIndex === null && firstCardIndex !== idx) {
            secondCardIndex = idx;
            movimientos++;
            movesSpan.innerText = moves;
            lockBoard = verdadero;
            checkCotchLogic();
        }
    }

    función checkMatchLogic() {
        const tarjetaA = tarjetasActuales[índicePrimeraTarjeta];
        const tarjetaB = tarjetasActuales[índiceSegundaTarjeta];
        const isMatch = (cardA.pairId === cardB.pairId);
        si (isMatch) {
            tarjetaA.coincide = verdadero;
            tarjetaB.coincide = verdadero;
            pares coincidentes++;
            firstCardIndex = null;
            secondCardIndex = null;
            lockBoard = falso;
            renderGame();
            speakText("¡Buena coincidencia!");
            comprobarVictoria();
        } demás {
            setTimeout(() => {
                if (currentCards[firstCardIndex]) currentCards[firstCardIndex].flipped = false;
                if (currentCards[secondCardIndex]) currentCards[secondCardIndex].flipped = false;
                firstCardIndex = null;
                secondCardIndex = null;
                lockBoard = falso;
                renderGame();
            }, 700);
        }
    }

    función startLevel(nivel) {
        detener el temporizador();
        nivelactual = nivel;
        juegoActivo = verdadero;
        JuegoFinalizado = falso;
        movimientos = 0;
        segundosdeltemporizador = 0;
        pares coincidentes = 0;
        firstCardIndex = null;
        secondCardIndex = null;
        lockBoard = falso;
        currentCards = buildDeck(currentLevel);
        totalPares = currentCards.length / 2;
        actualizarStarsUI(0);
        renderGame();
        startTimer();
        nextLevelBtn.style.display = "ninguno";
        retryBtn.innerText = "🔄 REINTENTAR NIVEL";
        gameMessageDiv.innerHTML = `🎯 Nivel ${currentLevel} - ${totalPairs} pares. Relación imagen real con palabra ¡Buena suerte!`;
        levelSpan.innerText = nivelActual;
        gameBoardArea.style.display = "block";
        levelSelectorArea.style.display = "none";
    }

    función retryLevel() {
        detener el temporizador();
        juegoActivo = verdadero;
        JuegoFinalizado = falso;
        movimientos = 0;
        segundosdeltemporizador = 0;
        pares coincidentes = 0;
        firstCardIndex = null;
        secondCardIndex = null;
        lockBoard = falso;
        currentCards = buildDeck(currentLevel);
        totalPares = currentCards.length / 2;
        actualizarStarsUI(0);
        renderGame();
        startTimer();
        nextLevelBtn.style.display = "ninguno";
        gameMessageDiv.innerHTML = `🔄 Reiniciaste Nivel ${currentLevel}. ¡A conseguir estrellas!`;
    }

    función nextLevel() {
        si (nivelactual < 5) {
            startLevel(currentLevel + 1);
        } demás {
            gameMessageDiv.innerHTML = "🏆 ¡Ya eres un experto! Juega de nuevo presionando Reintentar.";
        }
    }

    función buildLevelSelector() {
        nivelButtonsContainer.innerHTML = "";
        const levelInfo = {1:5, 2:8, 3:11, 4:14, 5:18};
        para (sea i = 1; i <= 5; i++) {
            const btn = document.createElement("button");
            btn.className = "level-btn";
            btn.innerText = `⭐ NIVEL ${i} (${levelInfo[i]} pares)`;
            btn.addEventListener("click", () => startLevel(i));
            levelButtonsContainer.appendChild(btn);
        }
    }

    startBtn.addEventListener("click", () => {
        entryOverlay.style.opacity = "0";
        setTimeout(() => {
            entryOverlay.style.display = "none";
            gameContainer.style.display = "block";
            construirSelectorDeNivel();
            levelSelectorArea.style.display = "block";
            gameBoardArea.style.display = "none";
            gameMessageDiv.innerHTML = "👉 Elige un nivel para comenzar a jugar";
        }, 500);
    });

    retryBtn.addEventListener("click", retryLevel);
    nextLevelBtn.addEventListener("click", nextLevel);
    gameContainer.style.display = "ninguno";
</script>
</body>
</html>
