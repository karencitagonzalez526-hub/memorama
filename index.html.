        Si (!juegoActivo || tableroBloqueado || juegoFinalizado) regresar;
        const tarjeta = tarjetasActuales[idx];
        si (card.matched || card.flipped) regresar;
        Si (firstCardIndex !== null && secondCardIndex !== null) regresar;

        tarjeta.volteada = verdadero;
        renderGame();
        speakText(card.wordObj.audioText);

